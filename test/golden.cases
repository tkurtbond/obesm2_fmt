# Golden-output cases for test/golden.sh (PLAN.md, section 8).
#
# One case per line: REF ID FIXTURES FLAGS...
#   REF       the program whose output is the reference: "ada" (the Ada
#             besm2_fmt, $ADA_BESM2_FMT) or "scheme" (besm2-rst,
#             $SCHEME_BESM2_RST), used only where the Ada version is
#             known to be wrong and the port follows besm2-rst.scm
#   ID        names the golden files: test/golden/FIXTURE.ID.out
#   FIXTURES  a shell glob in test/data, without ".yaml"
#   FLAGS     the command-line options, before the fixture's path
# Blank lines and lines starting with # are ignored.  Golden files hold
# standard output and standard error together; every case must exit 0.

# ---- terse (step 5) ----
ada    t          *-2e   -t
ada    s-t        *-2e   -s -t
ada    t-bold     *-2e   -t -b -l -M
ada    t-italic   *-2e   -t -i -n
ada    t-bold-it  *-2e   -t -b -i
ada    t-page     *-2e   -t -p
ada    t-page-D   *-2e   -t -p -D
ada    t-under    *-2e   -t -u = -U ~
ada    t-last     *-2e   -H -m -t

# ---- grid, the default (step 6) ----
ada    grid       *-2e
ada    s          *-2e   -s
ada    one        *-2e   -1
ada    one-s-B    *-2e   -1 -s -B
ada    no-bold    *-2e   -B -D
ada    ascii      *-2e   -s -n
ada    w72        *-2e   -w 72
ada    w25        *-2e   -w 25
ada    under      *-2e   -u = -U ~
ada    emph       *-2e   -b -i -l -M -p

# ---- h-m-m (step 7) ----
ada    hmm        *-2e   -H
ada    hmm-s      *-2e   -H -s
ada    hmm-S      *-2e   -H -S
ada    hmm-sS     *-2e   -H -s -S
ada    hmm-bold   *-2e   -H -b
ada    hmm-emph   *-2e   -H -i -l -M
ada    hmm-L2     *-2e   -H -L 2
ada    hmm-D-n    *-2e   -H -D -n
ada    hmm-root   *-2e   -H -R Root -L 1
ada    t-hmm      *-2e   -t -H

# The Ada sort isn't stable: names equal but for case come out in an
# arbitrary order.  besm2-rst's, like the port's, keeps document order
# (PLAN.md, step 5).
scheme t          sort-ties   -t
